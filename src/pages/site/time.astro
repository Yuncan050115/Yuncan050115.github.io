---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';

const timeline = [
  {
    year: '2023',
    title: '绷',
    text: '刚18哥们'
  },
  {
    year: '2024',
    title: '绷',
    text: '这年我还是'
  },
  {
    year: '2025',
    title: '绷绷炸弹',
    text: '绷不住，粥玩多了有感觉吗'
  },
  {
    year: '2026',
    title: '绷不住了',
    text: '别绷，寰宇好友邀一邀'
  }
];
---

<BaseLayout title="旧时光">
  <PageHero title="旧时光" description="这些年站点的一点变化，按年份记在这里。" />
  <section class="content-shell memory-river">
    {timeline.map((item, index) => (
      <article class="memory-card breathe-card" style={`--i:${index}`}>
        <time>{item.year}</time>
        <div>
          <h2>{item.title}</h2>
          <p>{item.text}</p>
        </div>
      </article>
    ))}
  </section>
</BaseLayout>
