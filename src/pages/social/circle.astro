---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import circleFeed from '../../../content/data/circle-feed.json';

const articles = Array.isArray(circleFeed) ? circleFeed : [];
// 有数据即渲染：构建时直接抓取友链 RSS，不再依赖外部 fcircle API
const hasData = articles.length > 0;
// 快照时间标记：取动态中最晚的更新时间，便于读者判断数据新鲜度
const latestStamp = articles.reduce((max, item) => {
  const stamp = String(item.updated || item.created || '');
  return stamp > max ? stamp : max;
}, '');

// 按作者+日期分组：同一天同一人的多条动态折叠，避免刷屏看不到其他人
interface FeedItem { floor?: number; title?: string; created?: string; updated?: string; link?: string; author?: string; avatar?: string; summary?: string; }
interface FeedGroup { key: string; author: string; avatar: string; date: string; items: FeedItem[]; }

const groups: FeedGroup[] = [];
for (const item of articles) {
  const author = item.author || '未知站点';
  const date = String(item.updated || item.created || '');
  const key = `${author}||${date}`;
  const last = groups[groups.length - 1];
  if (last && last.key === key) {
    last.items.push(item);
  } else {
    groups.push({ key, author, avatar: item.avatar || '', date, items: [item] });
  }
}
---
<BaseLayout title="朋友圈 - 云灿">
  <PageHero title="朋友圈" subtitle="友链站点动态聚合" />
  <section class="content-shell">
    {hasData ? (
      <>
        <p class="circle-status is-live" data-circle-status>
          {latestStamp ? `构建时直接抓取友链 RSS · 最近动态 ${latestStamp}` : '友链动态聚合'}
        </p>
        <div class="circle-container" data-circle-container>
          {groups.length ? (
            groups.map((group) => (
              <article class="circle-card" data-circle-group={group.items.length > 1 ? 'collapsible' : 'single'}>
                <div class="circle-card-header">
                  {group.avatar ? (
                    <img class="circle-avatar" src={group.avatar} alt="" loading="lazy" decoding="async" referrerpolicy="no-referrer" onerror="this.style.display='none'" />
                  ) : null}
                  <a href={group.items[0].link || '#'} target="_blank" rel="noopener" class="circle-author">
                    {group.author}
                  </a>
                  <time class="circle-date">{group.date}</time>
                </div>
                <h3 class="circle-title">
                  <a href={group.items[0].link || '#'} target="_blank" rel="noopener">
                    {group.items[0].title || '无标题'}
                  </a>
                </h3>
                {group.items[0].summary && <p class="circle-desc">{group.items[0].summary}</p>}

                {group.items.length > 1 && (
                  <div class="circle-more" data-circle-more>
                    <button type="button" class="circle-more-toggle" data-circle-toggle>
                      展开同日另外 {group.items.length - 1} 篇
                    </button>
                    <div class="circle-more-list" data-circle-more-list hidden>
                      {group.items.slice(1).map((item) => (
                        <a class="circle-more-item" href={item.link || '#'} target="_blank" rel="noopener">
                          <span class="circle-more-title">{item.title || '无标题'}</span>
                        </a>
                      ))}
                    </div>
                  </div>
                )}
              </article>
            ))
          ) : (
            <p class="circle-empty">暂无动态</p>
          )}
        </div>
      </>
    ) : (
      <div class="circle-empty">
        <h3>暂无友链动态</h3>
        <p>构建时会自动从 <code>content/data/link.yml</code> 读取友链列表并抓取各站点 RSS。</p>
        <p>当前没有获取到动态，可能原因：</p>
        <ol>
          <li>友链站点暂时不可达或 RSS 地址未适配</li>
          <li>构建时网络异常，请重新触发构建</li>
          <li><code>link.yml</code> 中尚未配置友链</li>
        </ol>
      </div>
    )}
  </section>

  <script>
    // 同日同作者多条动态折叠/展开
    document.querySelectorAll('[data-circle-toggle]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const wrap = btn.closest('[data-circle-more]');
        const list = wrap?.querySelector<HTMLElement>('[data-circle-more-list]');
        if (!list) return;
        const expanded = !list.hidden;
        list.hidden = expanded;
        btn.textContent = expanded
          ? btn.textContent.replace('收起', '展开')
          : btn.textContent.replace('展开', '收起');
      });
    });
  </script>

</BaseLayout>
