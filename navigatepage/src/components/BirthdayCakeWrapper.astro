---
import BirthdayCake from './BirthdayCake.vue';

const { birthdayPerson = 'ZHX' } = Astro.props;
---

<div class="birthday-cake-wrapper">
  <BirthdayCake client:load birthdayPerson={birthdayPerson} />
</div>

<style>
  /* 引入精华老宋字体 */
  @font-face {
    font-family: 'JingHuaLaoSong';
    src: url('/assets/JingHuaLaoSong.ttf') format('truetype');
    font-weight: normal;
    font-style: normal;
    font-display: swap;
  }

  .birthday-cake-wrapper {
    position: fixed;
    bottom: 0;
    right: 0;
    z-index: 9999;
    font-family: 'JingHuaLaoSong', serif;
  }
</style>

<script>
  // 添加confetti库支持
  document.addEventListener('DOMContentLoaded', () => {
    if (!window.confetti) {
      const confettiScript = document.createElement('script');
      confettiScript.src =
        'https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js';
      document.head.appendChild(confettiScript);
    }
  });
</script>

